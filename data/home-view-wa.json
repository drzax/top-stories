        "contentUri": "coremedia://teaser/107219566",
        "label": null,
        "title": " Strangers united in tough bushland in last-ditch search for the Nannup Four",
        "content": {
          "descriptor": {
            "type": "tagname",
            "key": "div",
            "props": {},
            "children": [
              {
                "type": "tagname",
                "key": "@@standfirst",
                "props": {},
                "children": [
                  {
                    "type": "text",
                    "content": "Armed with shovels, rakes and chainsaws, a team of citizen searchers are scouring a stretch of unforgiving bushland in southern Western Australia with one objective: find the remains of four people they've never met."
                  },
                  {
                    "type": "tagname",
                    "key": "br",
                    "props": {},
                    "children": []
                  },
                  {
                    "type": "tagname",
                    "key": "br",
                    "props": {},
                    "children": []
                  },
                  {
                    "type": "text",
                    "content": "Chantelle McDougall, her daughter Leela, Simon Kadwill and Tony Popic vanished from the outskirts of the small West Australian town of Nannup in 2007. They left a note saying they were travelling to Brazil, but their passports had not been used and their bank accounts were untouched."
                  }
                ]
              }
            ]
          }
        },
        "dates": {
          "firstPublished": "2026-10-01T20:54:07+00:00",
          "lastUpdated": "2026-10-01T20:54:07+00:00"
        },
