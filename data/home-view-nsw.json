        "title": "The race to save tiny bee almost no one knew existed",
        "content": {
          "descriptor": {
            "type": "tagname",
            "key": "div",
            "props": {},
            "children": [
              {
                "type": "tagname",
                "key": "@@standfirst",
                "props": {},
                "children": [
                  {
                    "type": "text",
                    "content": "It is a rare bee barely the size of a grain of rice, but the "
                  },
                  {
                    "type": "tagname",
                    "key": "em",
                    "props": {},
                    "children": [
                      {
                        "type": "text",
                        "content": "Hylaeus navai"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "content": " is an example of a species that could have been lost to history before it was found."
                  }
                ]
              }
            ]
          }
        },
