        "contentUri": "coremedia://teaser/107295426",
        "label": null,
        "title": "Roads and schools closed as flash flooding hits south-east Queensland",
        "content": {
          "descriptor": {
            "type": "tagname",
            "key": "div",
            "props": {},
            "children": [
              {
                "type": "tagname",
                "key": "@@standfirst",
                "props": {},
                "children": [
                  {
                    "type": "text",
                    "content": "Several people have been rescued from floodwaters overnight as heavy rainfall sets in across central and southern Queensland."
                  }
                ]
              },
              {
                "type": "tagname",
                "key": "p",
                "props": {},
                "children": [
                  {
                    "type": "text",
                    "content": "Almost 140mm fell in the three hour period to 7:30am this morning at Caboolture, north of Brisbane."
                  }
                ]
              },
              {
                "type": "tagname",
                "key": "p",
                "props": {},
                "children": [
                  {
                    "type": "text",
                    "content": "A watch and act prepare to leave warning has been issued for some regions."
                  }
                ]
              }
            ]
          }
        },
